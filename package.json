{
  "name": "runmeal-brand-mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.20.0",
    "expo": "~58.0.13",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
